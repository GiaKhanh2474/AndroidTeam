<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment" android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:defaultNavHost="true" app:navGraph="@navigation/nav_graph" />
    <FrameLayout android:id="@+id/left_market_drawer_container"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="@color/bg_drawer_surface">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/drawer_market_fragment_container" android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:navGraph="@navigation/drawer_nav_graph" />
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
