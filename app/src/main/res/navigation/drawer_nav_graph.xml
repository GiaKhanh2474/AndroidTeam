    android:id="@+id/drawer_graph" app:startDestination="@id/mainFragment">
    <fragment android:id="@id/mainFragment" android:name="androidx.fragment.app.Fragment" />
    <fragment android:id="@id/marketDrawerFragment" android:name="com.vlu.newsapi.ui.market.MarketDrawerFragment" />
    <fragment android:id="@id/articleDetailFragment" android:name="com.vlu.newsapi.ui.detail.ArticleDetailFragment">
        <argument android:name="articleId" app:argType="string" />
    </fragment>
</navigation>
