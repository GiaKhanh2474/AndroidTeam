<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!--
      Man dang nhap: man vao ung dung, nam ngoai 5 man cua dac ta.

      Vi la start destination nen mo ung dung la thay ngay man nay. Sau khi dang nhap, chinh no bi
      day khoi back stack (popUpTo kem chinh no) de nut Back o trang chinh thoat ung dung chu khong
      quay lai man dang nhap.

      Day la man GIAO DIEN MINH HOA: khong co nguon tai khoan that, xem AuthRepository.
    -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.news.ui.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!--
      Man dang ky: mo tu man dang nhap.

      Cung la man giao dien minh hoa. Vao trang chinh thi day ca man dang nhap lan man dang ky khoi
      back stack, vi sau khi dang ky xong thi khong con ly do gi quay lai hai man nay.
    -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.news.ui.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_registerFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Man 1: Main. La start destination nen KHONG hien mui ten Up tren toolbar. -->
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.news.ui.main.MainFragment"
        android:label="@string/title_main"
        tools:layout="@layout/fragment_main">

        <action
            android:id="@+id/action_mainFragment_to_categoryTimelineFragment"
            app:destination="@id/categoryTimelineFragment" />

        <action
            android:id="@+id/action_mainFragment_to_marketDrawerFragment"
            app:destination="@id/marketDrawerFragment" />

        <action
            android:id="@+id/action_mainFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- Man 2: danh sach bai bao theo chuyen muc, nhom theo ngay dang. -->
    <fragment
        android:id="@+id/categoryTimelineFragment"
        android:name="com.example.news.ui.timeline.CategoryTimelineFragment"
        android:label="@string/title_category_timeline"
        tools:layout="@layout/fragment_category_timeline">

        <!-- id chuyên mục được truyền từ màn Main sang. -->
        <argument
            android:name="categoryId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Man 4: bang thi truong (bieu do, tin van, bang xep hang). -->
    <fragment
        android:id="@+id/marketDrawerFragment"
        android:name="com.example.news.ui.market.MarketDrawerFragment"
        android:label="@string/title_market_drawer"
        tools:layout="@layout/fragment_market_drawer">

        <!--
          Biểu đồ cần đưa lên đầu trang, truyền từ danh sách "biểu đồ đã lưu" ở màn Tài khoản.
          Để trống khi vào màn Thị trường theo cách thường; khi đó trang dùng danh sách ưu tiên
          đã lưu. Đây chỉ là lựa chọn CÁCH XEM cho lần mở này, không ghi gì vào cơ sở dữ liệu.
        -->
        <argument
            android:name="focusedSeriesId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Man 5: tai khoan + bai da luu + bieu do da luu. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.news.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_infoPageFragment"
            app:destination="@id/infoPageFragment" />

        <action
            android:id="@+id/action_profileFragment_to_marketDrawerFragment"
            app:destination="@id/marketDrawerFragment" />

        <!--
          "Dang xuat" o header man Tai khoan.

          Chua co phien dang nhap that de huy, nen viec dang xuat lam duoc dung mot viec that su: dua
          nguoi dung ve man dang nhap. Day luon ca trang chinh khoi back stack de nut Back khong mo
          lai duoc trang Tai khoan vua roi.
        -->
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!--
      Man dung chung cho cac dong "mo man khac" o trang Tai khoan.

      Vi sao dung chung mot man thay vi moi dong mot man: cac dong nay hien chi la cho dang cho
      noi dung that, nen mot man chung giu nguyen so luong man hinh cua ung dung va khong bia ra
      noi dung cho tung man rieng le. Man nay nhan khoa trang, tu tra ra tieu de va noi dung.
    -->
    <fragment
        android:id="@+id/infoPageFragment"
        android:name="com.example.news.ui.info.InfoPageFragment"
        android:label="@string/title_info_page"
        tools:layout="@layout/fragment_info_page">

        <argument
            android:name="page"
            app:argType="string" />
    </fragment>

</navigation>
