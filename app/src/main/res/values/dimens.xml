<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Khoảng cách dùng chung -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>

    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="card_elevation">1dp</dimen>
    <!-- Ô phẳng (không đổ bóng) để lưới 3×3 trông như một khối liền. -->
    <dimen name="card_elevation_flat">0dp</dimen>
    <!-- Đường viền mảnh của thẻ bài báo ở trang Chuyên mục. -->
    <dimen name="card_stroke_width">1dp</dimen>

    <!-- Nút biểu tượng trên header ([☰], [👤], [←]) — vùng chạm tối thiểu 48dp. -->
    <dimen name="icon_button_size">48dp</dimen>

    <!-- Ô tìm kiếm trên thanh công cụ thông minh của trang Chính. -->
    <dimen name="search_bar_height">40dp</dimen>
    <dimen name="search_bar_corner_radius">20dp</dimen>

    <!-- Màn Main: quãng kéo tối thiểu để chữ "Main" mờ đi và cụm [☰][🔍][👤] hiện ra. -->
    <dimen name="main_header_scroll_threshold">24dp</dimen>

    <!-- Màn Thị trường: vùng vẽ biểu đồ và cỡ chữ nhãn trên biểu đồ. -->
    <dimen name="chart_height">180dp</dimen>
    <dimen name="chart_label_text_size">10sp</dimen>

    <!-- Cử chỉ: quãng ngang tối thiểu để một thao tác kéo được coi là "vuốt về Main".
         64dp đủ xa để không trùng với những cú chạm hoặc rung tay khi bấm. -->
    <dimen name="swipe_back_min_distance">64dp</dimen>

    <!--
      Kích thước bổ sung cho Base UI của 3 màn cốt lõi (Mục I.2 của đặc tả).

      Không gõ cứng số đo trong layout: mọi chỗ dùng đều tham chiếu các tên dưới đây.
    -->

    <!-- Ô Grid con (3×3) ở trang Chính: chiều cao tối thiểu để 3 ô cùng hàng luôn cao bằng
         nhau, chữ dài bị cắt bằng ellipsize thay vì làm lệch hàng. -->
    <dimen name="grid_sub_item_min_height">120dp</dimen>

    <!-- Trang Chi tiết: cỡ chữ tiêu đề bài báo và nội dung bài. -->
    <dimen name="font_detail_headline">24sp</dimen>
    <dimen name="font_detail_body">16sp</dimen>

    <!-- Trang Chi tiết: chiều cao ảnh lớn ở giữa bài (đặc tả ghi 220dp). -->
    <dimen name="detail_banner_image_height">220dp</dimen>

    <!-- Trang Chi tiết: đường kính nút mũi tên mờ ↑ ở góc dưới bên phải. -->
    <dimen name="detail_up_arrow_size">40dp</dimen>
</resources>
