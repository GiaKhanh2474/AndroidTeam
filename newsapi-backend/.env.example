PORT=5000
MONGODB_URI=your_mongodb_uri_here
NEWS_API_KEY=your_news_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin uses Application Default Credentials. Keep the JSON file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
GOOGLE_CLOUD_PROJECT=your_firebase_project_id

# Admin crawl is denied unless a key is set.
ADMIN_KEY=
# Local demo only: BOTH settings below are required to bypass the admin key.
NODE_ENV=development
ADMIN_ALLOW_UNAUTHENTICATED=false
