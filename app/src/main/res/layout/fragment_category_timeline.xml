<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn 2 — Chuyên mục theo ngày (Mục 2.1 của đặc tả).

  Header: [←]  TÊN CHUYÊN MỤC.
    - btn_back_category: nút [←] thoát về trang Main.
    - tv_category_title: tên chuyên mục, ví dụ "Chuyên mục: Kinh tế".
  Thân trang: rv_category_timeline, danh sách dọc gồm mốc NGÀY và các thẻ nằm ngang bên dưới.

  Vẫn bọc trong SwipeBackLayout: lướt từ trái sang phải cũng thoát về Main, song song với nút
  [←] đúng yêu cầu "thoát trang kép" của đặc tả.
-->
<com.vlu.newsapi.ui.common.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ui.category.CategoryTimelineFragment">

    <LinearLayout
        android:id="@+id/header_category"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md">

        <ImageButton
            android:id="@+id/btn_back_category"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            tools:text="Chuyên mục: Kinh tế" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_lg"
        tools:listitem="@layout/item_article_horizontal_card" />

</com.vlu.newsapi.ui.common.SwipeBackLayout>
