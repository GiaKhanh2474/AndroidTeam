<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn 1 — Main (Mục 1 của đặc tả).

  Thanh [☰] - [Search] - [👤] luôn hiện ở đầu trang theo yêu cầu cập nhật.
  Nằm ngoài vùng cuộn và các trạng thái loading/error để luôn truy cập được.

  MA TRẬN 3×3: ba khối chuyên mục xếp dọc, mỗi khối có tiêu đề và một RecyclerView 3 cột
  (GridLayoutManager(3)). Mỗi ô Grid con chỉ có chữ tóm tắt, KHÔNG có ảnh — đúng quy tắc
  thiết kế của đặc tả.

  KHÔNG có Bottom Navigation: điều hướng bằng thanh công cụ này và cử chỉ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ui.main.MainFragment">

    <FrameLayout
        android:id="@+id/header_main"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <!-- Thanh điều hướng cố định, không cần kéo để hiện. -->
        <LinearLayout
            android:id="@+id/top_smart_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btn_menu_drawer"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_market"
                android:src="@drawable/ic_menu" />

            <EditText
                android:id="@+id/et_search_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_bar_height"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_search_bar"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/spacing_sm"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btn_avatar_profile"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_profile"
                android:src="@drawable/ic_person" />
        </LinearLayout>
    </FrameLayout>

    <!-- Nhãn nguồn dữ liệu tin tức. -->
    <TextView
        android:id="@+id/tv_mock_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xs"
        android:text="@string/mock_data_notice"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!--
      Vùng cuộn nội dung. Thanh công cụ phía trên không cuộn theo.
      fillViewport để nội dung ngắn vẫn phủ kín màn hình.
    -->
    <!--
      Vùng nội dung. Bọc thêm FrameLayout để đặt 3 trạng thái chồng lên nhau:
      progress_main (đang gọi API 1), nội dung 3 lưới, và error_main (lỗi mạng + nút Thử lại).
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

        <!-- Khối bọc 3 Grid. -->
        <LinearLayout
            android:id="@+id/container_three_grids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Khối 1 — Kinh tế -->
            <TextView
                android:id="@+id/tv_header_kinh_te"
                style="@style/NewsText.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/category_economy" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_grid_kinh_te"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_main_sub_grid" />

            <!-- Khối 2 — Chính trị -->
            <TextView
                android:id="@+id/tv_header_chinh_tri"
                style="@style/NewsText.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/category_politics" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_grid_chinh_tri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_main_sub_grid" />

            <!-- Khối 3 — Công nghệ -->
            <TextView
                android:id="@+id/tv_header_cong_nghe"
                style="@style/NewsText.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/category_technology" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_grid_cong_nghe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_main_sub_grid" />
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary" />

        <LinearLayout
            android:id="@+id/error_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_main_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/error_load_news"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Button
                android:id="@+id/btn_main_retry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
