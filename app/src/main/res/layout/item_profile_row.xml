<?xml version="1.0" encoding="utf-8"?>
<!--
  Một dòng bấm được ở trang Tài khoản.

  Dùng chung cho cả bốn loại dòng của màn này: "Nâng cấp tài khoản", "Xoá dữ liệu đã lưu",
  "Ngôn ngữ", biểu đồ đã lưu và bài báo đã lưu. Bốn loại chỉ khác nhau ở chữ, ở biểu tượng đầu
  dòng và ở việc có mũi tên cuối dòng hay không, nên gộp vào một layout.

  Biểu tượng và mũi tên đều có thể ẩn đi (visibility) tuỳ từng dòng.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_upgrade" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Nâng cấp tài khoản" />

            <TextView
                android:id="@+id/tvRowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Mở khoá toàn bộ biểu đồ và bỏ giới hạn số bài lưu" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivRowChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
