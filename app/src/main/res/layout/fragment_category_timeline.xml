<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn 2 — Chuyên mục theo ngày.

  Header đặc tả: [←]  TÊN CHUYÊN MỤC  ...........  [📅 Chọn ngày]
  Tên chuyên mục do Fragment đổ vào sau khi có dữ liệu; trước đó tạm hiện "Chuyên mục".

  Thân trang: danh sách bài báo chia theo mốc ngày đăng. Mỗi bài là một khung chữ nhật
  nằm ngang, KHÔNG dùng ảnh nhỏ: chữ to là tiêu đề, chữ nhỏ là tóm tắt.
-->
<com.example.news.ui.common.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ui.timeline.CategoryTimelineFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/title_category_timeline"
        app:titleTextAppearance="@style/TextAppearance.News.ToolbarTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_lg"
        tools:listitem="@layout/item_timeline_day" />

</com.example.news.ui.common.SwipeBackLayout>
