<?xml version="1.0" encoding="utf-8"?>
<!--
  Single Activity: chỉ giữ NavHost.
  Mỗi màn tự quản header riêng vì đặc tả yêu cầu header rất khác nhau:
    Main      : chữ "Main"  ->  lướt xuống thì đổi thành [☰][🔍 Tìm kiếm][👤]
    Chuyên mục: [←] TÊN CHUYÊN MỤC ............ [📅 Chọn ngày]
    Thị trường: [☰] BIỂU ĐỒ & DANH MỤC ......... [✕]
    Tài khoản : [←] TÀI KHOẢN CÁ NHÂN .......... [Đăng xuất]
  KHÔNG dùng Bottom Navigation theo đặc tả.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</FrameLayout>
