<?xml version="1.0" encoding="utf-8"?>
<!--
  Một "Grid Con" trên màn Main: CHỮ TO là tiêu đề bài báo, CHỮ NHỎ là tóm tắt.
  Chiều rộng do adapter chia đều (3 ô một hàng); chiều cao lấy theo containerCards.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <TextView
            android:id="@+id/tvArticleTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold"
            tools:text="Tăng trưởng quý này vượt dự báo" />

        <TextView
            android:id="@+id/tvArticleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Mức tăng cao hơn kỳ vọng nhờ sản xuất công nghiệp phục hồi." />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
