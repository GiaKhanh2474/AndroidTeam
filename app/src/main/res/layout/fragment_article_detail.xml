<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn 3 — Chi tiết bài báo (Mục 3.1 của đặc tả).

  Thứ tự trong vùng cuộn, đúng như tài liệu UI/UX:
    TIÊU ĐỀ BÀI BÁO (chữ lớn, in đậm, căn trái)
    Nguồn báo • Ngày đăng
    🔗 Đọc bài gốc trên trang web chính thức ↗
    Ảnh lớn của bài báo (tải bằng Glide)
    Nội dung chi tiết

  Nút [←] đặt CỐ ĐỊNH ở góc trên cùng (không nằm trong vùng cuộn): nếu để nó trôi theo nội
  dung thì đọc tới giữa bài sẽ không còn đường thoát nhanh, trong khi đặc tả gọi đây là "nút
  thoát nhanh". Cử chỉ lướt phải cũng thoát được trang.

  Nút mũi tên mờ ↑ nằm ngoài vùng cuộn, góc dưới bên phải, mặc định ẩn — mã sẽ tự hiện/ẩn
  theo vị trí cuộn (GestureHelper).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.detail.ArticleDetailFragment">

    <ImageButton
        android:id="@+id/btn_back_detail"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_detail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Tiêu đề bài báo: cỡ chữ lấy từ @dimen/font_detail_headline. -->
            <TextView
                android:id="@+id/tv_detail_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/font_detail_headline"
                android:textStyle="bold"
                tools:text="Tăng trưởng quý này vượt dự báo" />

            <!-- Nguồn báo + ngày đăng: "Bản tin minh hoạ • Ngày 22/10/2026". -->
            <TextView
                android:id="@+id/tv_detail_source_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/text_meta_date"
                tools:text="Bản tin minh hoạ • Ngày 22/10/2026" />

            <!-- Link bài gốc: nằm NGAY dưới dòng nguồn báo, màu xanh, bấm mở trình duyệt. -->
            <TextView
                android:id="@+id/tv_original_web_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:text="@string/detail_original_link"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_original_web_link" />

            <!-- Ảnh lớn của bài báo: chiều cao và kiểu cắt lấy theo đặc tả, ảnh do Glide tải. -->
            <ImageView
                android:id="@+id/iv_detail_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_banner_image_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="?attr/colorSurfaceVariant"
                android:contentDescription="@string/detail_banner_content_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_placeholder"
                tools:ignore="ImageContrastCheck" />

            <!-- Nội dung bài: cỡ chữ @dimen/font_detail_body, giãn dòng 1.4 theo đặc tả. -->
            <TextView
                android:id="@+id/tv_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/font_detail_body"
                tools:text="Đây là nội dung minh hoạ cho bài báo…" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Trạng thái đang tải API 3. -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Trạng thái lỗi mạng, hoặc không tìm thấy bài (khi đó ẩn nút Thử lại). -->
    <LinearLayout
        android:id="@+id/error_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_detail_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Không tải được bài báo. Kiểm tra kết nối mạng." />

        <Button
            android:id="@+id/btn_detail_retry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/action_retry" />
    </LinearLayout>

    <!-- Mũi tên mờ ↑: mặc định ẩn, mã tự hiện khi đọc sâu rồi lướt ngược lên. -->
    <ImageButton
        android:id="@+id/btn_faded_up_arrow"
        android:layout_width="@dimen/detail_up_arrow_size"
        android:layout_height="@dimen/detail_up_arrow_size"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_faded_up_arrow"
        android:contentDescription="@string/detail_scroll_to_top"
        android:src="@drawable/ic_arrow_up"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
